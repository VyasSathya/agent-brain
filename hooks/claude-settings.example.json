{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"/abs/path/to/agent-brain/agent_brain/continuity.py\" --brain \"/abs/path/to/your-brain\" hook-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"/abs/path/to/agent-brain/agent_brain/continuity.py\" --brain \"/abs/path/to/your-brain\" hook-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
